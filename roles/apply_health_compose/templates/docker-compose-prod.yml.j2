# Health-dashboard stack — active-active on every bang. NOT VIP-exclusive.
# Mirrors triage's docker-compose-prod.yml shape; all services use
# network_mode: host so they bind directly to the bang's tailscale interface.
#
# Rendered per-bang via ansible.builtin.template — inventory_hostname,
# bang_tailscale_ip, and the alertmanager cluster-peer list are
# substituted at deploy time.
#
# init: true on every service below (2026-09-25): none of these upstream
# entrypoints (prometheus, alertmanager, grafana-server, blackbox/snmp/
# smartctl exporters) is a PID-1 reaper, same orphan-accumulation risk as
# bmc_fw/bios_fw/server/api in triage's compose file. Defense in depth --
# no leak has been observed here, but tini as PID 1 costs nothing.

services:
  prometheus:
    image: prom/prometheus:v2.55.1
    restart: always
    init: true
    network_mode: host
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ apply_health_compose_retention_time }}"
      - "--storage.tsdb.retention.size={{ apply_health_compose_retention_size }}"
      - "--web.enable-lifecycle"
      - "--web.listen-address=0.0.0.0:9090"
      - "--web.external-url=http://{{ inventory_hostname }}.{{ bang_domain }}:9090"
    volumes:
      - /etc/flax/health/prometheus:/etc/prometheus:ro
      - prometheus-data:/prometheus

  alertmanager:
    image: prom/alertmanager:v0.27.0
    restart: always
    init: true
    network_mode: host
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"
      - "--cluster.listen-address=0.0.0.0:9094"
{#   One flag per live peer, none when there is none (a site whose standby is dormant):
     an empty `--cluster.peer=` stops alertmanager ("missing port in address"). #}
{% for peer in groups['jumphosts'] | difference([inventory_hostname] + apply_health_compose_dormant) %}
      - "--cluster.peer={{ hostvars[peer].bang_tailscale_ip }}:9094"
{% endfor %}
      - "--web.listen-address=0.0.0.0:9093"
      - "--web.external-url=http://{{ inventory_hostname }}.{{ bang_domain }}:9093"
    volumes:
      - /etc/flax/health/alertmanager:/etc/alertmanager:ro
      - alertmanager-data:/alertmanager

  grafana:
    image: grafana/grafana:11.3.0
    restart: always
    init: true
    network_mode: host
    environment:
      - GF_SERVER_HTTP_PORT=3000
      - GF_SERVER_ROOT_URL=https://health.{{ inventory_hostname }}.{{ bang_domain }}/
      - GF_PATHS_PROVISIONING=/etc/grafana/provisioning
    volumes:
      - /etc/flax/health/grafana/provisioning:/etc/grafana/provisioning:ro
      - /etc/flax/health/grafana/dashboards:/var/lib/grafana/dashboards:ro
      - grafana-data:/var/lib/grafana

  blackbox:
    image: prom/blackbox-exporter:v0.25.0
    restart: always
    init: true
    network_mode: host
    cap_add:
      - NET_RAW    # ICMP probes require raw sockets
    command:
      - "--config.file=/etc/blackbox/blackbox.yml"
      - "--web.listen-address=0.0.0.0:9115"
    volumes:
      - /etc/flax/health/blackbox:/etc/blackbox:ro

  snmp_exporter:
    image: prom/snmp-exporter:v0.26.0
    restart: always
    init: true
    network_mode: host
    command:
      - "--config.file=/etc/snmp_exporter/snmp.yml"
      - "--web.listen-address=0.0.0.0:9116"
    volumes:
      - /etc/flax/health/snmp:/etc/snmp_exporter:ro

  smartctl_exporter:
    image: quay.io/prometheuscommunity/smartctl-exporter:v0.13.0
    restart: always
    init: true
    network_mode: host
    privileged: true   # required to read SMART attributes
    # ... and root: the image runs as nobody, which privileged does not let open
    # /dev/sd* ("Permission denied" every 15 s, no smartctl_device_attribute at all).
    user: root
    command:
      - "--web.listen-address=:9633"

volumes:
  prometheus-data:
  alertmanager-data:
  grafana-data:
