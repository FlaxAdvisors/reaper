apiVersion: 1
# One datasource: this bang's own Prometheus (network_mode host, so localhost). The
# site health board shows its own site in full plus a federated summary of the
# others (site:* series), so no per-site datasources (operator 2026-11-09).
deleteDatasources:
  - name: braintree
    orgId: 1
  - name: eindhoven
    orgId: 1
  - name: lavergne
    orgId: 1
datasources:
  - name: prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    jsonData:
      timeout: 5
      httpMethod: GET
