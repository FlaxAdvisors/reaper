# Generated by apply_health_compose for {{ inventory_hostname }}.
# Each bang scrapes:
#   - itself + its peer bang (host metrics, exporters, hooks)
#   - its own site's switches (SNMP via snmp_exporter on this bang)
#   - blackbox probes for: internet anchors, peer bangs, own-site switches.
#   - federate: pulls the relevant subset of every other bang's data so
#     dashboards see all-sites state from any single grafana, and site
#     outage history survives because each prom keeps a local copy.

{# Federation pulls the other sites' summary from their primaries
   (apply_health_compose_federate: site -> primary bang). Own site: scraped directly. #}
{% set site_devices = (lookup('ansible.builtin.file', role_path ~ '/../../files/configs/' ~ site_name ~ '/devices.yml')
                       | from_yaml).devices %}

{# Dormant hosts (apply_health_compose_dormant) are no target anywhere below: a dead
   standby is not permanent alert noise. #}
{% set dormant = apply_health_compose_dormant %}
{% set live_bangs = groups['jumphosts'] | select('match', '^bang-') | reject('in', dormant) | list %}

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    bang: "{{ inventory_hostname }}"
    site: "{{ site_name }}"

rule_files:
  - /etc/prometheus/rules/*.yml
  - /etc/prometheus/recording-rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
{% for h in groups['jumphosts'] | reject('in', dormant) %}
            - "{{ hostvars[h].bang_tailscale_ip }}:9093"
{% endfor %}

scrape_configs:
  # ============================================================
  # Self & peer host metrics
  # ============================================================
  - job_name: node
    static_configs:
{% for h in live_bangs %}
      - targets: ["{{ hostvars[h].bang_tailscale_ip }}:9100"]
        labels: { bang: "{{ h }}", site: "{{ hostvars[h].site_name }}" }
{% endfor %}

  # ============================================================
  # SMART disk attributes (per bang)
  # ============================================================
  - job_name: smartctl
    static_configs:
{% for h in live_bangs %}
      - targets: ["{{ hostvars[h].bang_tailscale_ip }}:9633"]
        labels: { bang: "{{ h }}", site: "{{ hostvars[h].site_name }}" }
{% endfor %}

  # ============================================================
  # Internet uplink — blackbox ICMP + HTTP from THIS bang only
  # (each bang probes from its own location)
  # ============================================================
  - job_name: blackbox_internet_icmp
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
      - targets:
          - 1.1.1.1
          - 8.8.8.8
          - 9.9.9.9
        labels: { site: "{{ site_name }}" }
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ bang_tailscale_ip }}:9115"
      - target_label: probe_kind
        replacement: internet_uplink

  - job_name: blackbox_internet_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://1.1.1.1/
        labels: { site: "{{ site_name }}" }
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ bang_tailscale_ip }}:9115"

  # ============================================================
  # Peer-bang reachability — mgmt vlan ICMP from THIS bang to each peer
  # ============================================================
  - job_name: blackbox_peer_bangs
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
      - targets:
{% for h in live_bangs | difference([inventory_hostname]) %}
          - "{{ hostvars[h].bang_mgmt_ip }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ bang_tailscale_ip }}:9115"
      - target_label: probe_kind
        replacement: peer_bang_mgmt

  # ============================================================
  # Site devices (files/configs/<site>/devices.yml): ICMP to every LIVE device's
  # mgmt address and every bang's BMC. The site health board's device tiles read it.
  # ============================================================
  # A bang cannot reach its OWN BMC (NC-SI on its own NIC): that one is probed through
  # the peer bang's blackbox; with no live peer it is not pinged (health = in-band IPMI).
{% set peers = live_bangs | reject('equalto', inventory_hostname) | list %}
  - job_name: devices
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
{% for d in site_devices if (d.state | default('live')) == 'live' %}
{% if d.mgmt_ip | default('') %}
      - targets: ["{{ d.mgmt_ip }}"]
        labels: { site: "{{ site_name }}", device: "{{ d.name }}", target_kind: mgmt, probe_via: "{{ bang_tailscale_ip }}" }
{% endif %}
{% if d.bmc_ip | default('') and (d.name != inventory_hostname or peers) %}
      - targets: ["{{ d.bmc_ip }}"]
        labels: { site: "{{ site_name }}", device: "{{ d.name }}", target_kind: bmc, probe_via: "{{ hostvars[peers[0]].bang_tailscale_ip if d.name == inventory_hostname else bang_tailscale_ip }}" }
{% endif %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [probe_via]
        target_label: __address__
        replacement: "$1:9115"
      - regex: probe_via
        action: labeldrop

  # ============================================================
  # Own-site switch SNMP — driven by snmp_exporter on this bang
  # ============================================================
  - job_name: snmp_switches
    metrics_path: /snmp
    params:
      auth: [site_v2]
    # SNMP walks of the configured OIDs take ~11s on the Cisco 3750E
    # (turtle-gouda) — bump from the 10s scrape_timeout default and
    # widen the interval so the scrape can finish.
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
{# the LIVE switches of devices.yml: an offline/planned one is not scraped (no
   PrometheusTargetDown forever) #}
{% set snmp_module = {'arista': 'arista_eos', 'cumulus': 'cumulus_linux', 'cisco': 'cisco_ios'} %}
{% for d in site_devices if d.kind == 'switch' and (d.state | default('live')) == 'live' %}
      - targets: ["{{ d.mgmt_ip }}"]
        labels:
          site: "{{ site_name }}"
          switch: "{{ d.name }}"
          vendor: {{ d.vendor }}
          module: {{ snmp_module[d.vendor] }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ bang_tailscale_ip }}:9116"

  # ============================================================
  # Federation — pull the dashboard-relevant subset of every other
  # bang's metrics so this prom has a complete fleet view. Survives
  # peer-bang outages because the federated copies are stored locally.
  # Mirrors alertmanager's gossip resilience but at the metrics layer.
  # ============================================================
{% for s, bang in apply_health_compose_federate.items() if s != site_name and bang not in dormant %}
  # {{ s }}'s summary only, from its primary: matching site="{{ s }}" keeps another
  # primary's re-served copy of OUR series out (no echo, no out-of-order samples)
  - job_name: federate-{{ s }}
    honor_labels: true
    scrape_interval: 30s
    metrics_path: /federate
    params:
      'match[]':
        - '{__name__=~"site:.+",site="{{ s }}"}'
    static_configs:
      - targets: ["{{ bang }}.{{ bang_domain }}:9090"]
{% endfor %}
