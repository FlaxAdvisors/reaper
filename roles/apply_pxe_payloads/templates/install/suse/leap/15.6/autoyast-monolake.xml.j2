      </authorized_keys>
      <encrypted config:type="boolean">true</encrypted>
      <username>flax</username>
      <fullname>flax</fullname>
      <gid>100</gid>
      <groups>wheel</groups>
      <home>/home/flax</home>
      <home_btrfs_subvolume config:type="boolean">false</home_btrfs_subvolume>
      <password_settings>
        <expire/>
        <flag/>
        <inact/>
        <max>99999</max>
        <min>0</min>
        <warn>7</warn>
      </password_settings>
