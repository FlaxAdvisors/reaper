  <scripts>
    <post-scripts config:type="list">
      <script>
        <filename>post.sh</filename>
        <interpreter>shell</interpreter>
        <source>
	  <!--
          <![CDATA[
#!/bin/bash                

cp /etc/sudoers /tmp/sudoers
sed -i '$ a admin ALL=(ALL) NOPASSWD: ALL' /tmp/sudoers
sed -i '$ a flax ALL=(ALL) NOPASSWD: ALL' /tmp/sudoers
if visudo -c -f /tmp/sudoers ; then mv /tmp/sudoers /etc/sudoers ; fi

          ]]>
          -->
          <![CDATA[
#!/bin/bash                
cat<-'EOF'>/etc/sudoers.d/admin
admin ALL=(ALL) NOPASSWD: ALL
EOF
cat<-'EOF'>/etc/sudoers.d/flax
flax ALL=(ALL) NOPASSWD: ALL
EOF
          ]]>
          </source>
      </script>
    </post-scripts>
  </scripts>
</profile>
