<?xml version="1.0"?>
<!DOCTYPE profile>
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">
  <add-on>
    <add_on_products config:type="list">
      <listentry>
        <media_url><![CDATA[http://bang/install/rpmbuild]]></media_url>
        <product>bang</product>
        <product_dir>/</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[http://bang/install/suse/leap/15.6/ga]]></media_url>
        <product>bang</product>
        <product_dir>/</product_dir>
      </listentry>
      <!--
      <listentry>
        <media_url><![CDATA[http://download.opensuse.org/repositories/Kernel:/HEAD/standard]]></media_url>
        <product>Kernel:HEAD</product>
        <product_dir>/</product_dir>
        </listentry>
      -->
      <listentry>
        <media_url><![CDATA[https://download.opensuse.org/distribution/leap/15.6/repo/non-oss]]></media_url>
        <product>non-oss</product>
        <product_dir>/</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[https://download.opensuse.org/distribution/leap/15.6/repo/oss]]></media_url>
        <product>oss</product>
        <product_dir>/</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[http://download.opensuse.org/update/leap/15.6/non-oss]]></media_url>
        <product>non-oss-update</product>
        <product_dir>/</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[http://download.opensuse.org/update/leap/15.6/oss]]></media_url>
        <product>oss-update</product>
