#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: tempname
    password: "{{ vault_install_secrets.ubuntu_identity_hash }}"
    realname: pxadmin
    username: pxadmin
  keyboard:
    layout: us
    toggle: null
    variant: ""
  locale: en_us.UTF-8
  apt:
    geoip: false
    primary:
      - arches: [default]
        uri: http://mirrors.edge.kernel.org/ubuntu
    security:
      - arches: [default]
        uri: http://mirrors.edge.kernel.org/ubuntu
  packages:
    - stress-ng
    - rasdaemon
  ssh:
    allow-pw: true
    authorized-keys:
      [
{% for k in vault_install_authorized_keys %}
        "{{ k }}",
{% endfor %}
      ]
    install-server: true
  late-commands:
    - 'echo "pxadmin ALL=(ALL) NOPASSWD:ALL" > /target/etc/sudoers.d/pxadmin'
    - chmod 440 /target/etc/sudoers.d/pxadmin
    - rm /target/etc/hostname
    - shutdown -h now

  user-data:
    disable_root: true
    timezone: UTC
    package_upgrade: false
    users:
      - name: flax
        primary_group: users
        groups: sudo
        lock_passwd: false
        passwd: "{{ vault_install_secrets.ubuntu_flax_hash }}"
        shell: /bin/bash
        ssh_authorized_keys:
{% for k in vault_install_authorized_keys %}
          - "{{ k }}"
{% endfor %}
        sudo: ALL=(ALL) NOPASSWD:ALL

      - name: pxadmin
        primary_group: users
        groups: sudo
        lock_passwd: false
        passwd: "{{ vault_install_secrets.ubuntu_pxadmin_hash }}"
        shell: /bin/bash
        ssh_authorized_keys:
{% for k in vault_install_authorized_keys %}
          - "{{ k }}"
{% endfor %}
        sudo: ALL=(ALL) NOPASSWD:ALL
