#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: tempname
    password: "<<ubuntu_identity_hash>>"
    realname: pxadmin
    username: pxadmin
  keyboard:
    layout: us
    toggle: null
    variant: ""
  locale: en_us.UTF-8
  apt:
    geoip: false
    primary:
      - arches: [default]
        uri: http://mirrors.edge.kernel.org/ubuntu
    security:
      - arches: [default]
        uri: http://mirrors.edge.kernel.org/ubuntu
  packages:
    - stress-ng
    - rasdaemon
  ssh:
    allow-pw: true
    authorized-keys:
      [
        "<<KEY>>",
      ]
    install-server: true
  storage:
    config:
      - {
          ptable: gpt,
          path: /dev/sde,
          wipe: superblock,
          preserve: false,
          name: "",
          grub_device: false,
          type: disk,
          id: system-disk,
        }
      - {
          device: system-disk,
          size: 1127219200,
          wipe: superblock,
          flag: boot,
          number: 1,
          preserve: false,
          grub_device: true,
          type: partition,
          id: partition-0,
        }
      - {
          fstype: fat32,
          volume: partition-0,
          preserve: false,
          type: format,
          id: format-0,
        }
      - {
          device: system-disk,
          size: 2147483648,
          wipe: superblock,
          flag: "",
          number: 2,
          preserve: false,
          grub_device: false,
          type: partition,
          id: partition-1,
        }
      - {
          fstype: ext4,
          volume: partition-1,
          preserve: false,
          type: format,
          id: format-1,
        }
      - {
          device: system-disk,
          size: -1,
          wipe: superblock,
          flag: "",
          number: 3,
          preserve: false,
          grub_device: false,
          type: partition,
          id: partition-2,
        }
      - {
          name: ubuntu-vg,
          devices: [partition-2],
          preserve: false,
          type: lvm_volgroup,
          id: lvm_volgroup-0,
        }
      - {
          name: ubuntu-lv,
          volgroup: lvm_volgroup-0,
          size: 20G,
          wipe: superblock,
          preserve: false,
          type: lvm_partition,
          id: lvm_partition-0,
        }
      - {
          fstype: ext4,
          volume: lvm_partition-0,
          preserve: false,
          type: format,
          id: format-2,
        }
      - { path: /, device: format-2, type: mount, id: mount-2 }
      - { path: /boot, device: format-1, type: mount, id: mount-1 }
      - { path: /boot/efi, device: format-0, type: mount, id: mount-0 }
  late-commands:
    - 'echo "pxadmin ALL=(ALL) NOPASSWD:ALL" > /target/etc/sudoers.d/pxadmin'
    - chmod 440 /target/etc/sudoers.d/pxadmin
    - rm /target/etc/hostname
    - shutdown -h now

  user-data:
    disable_root: true
    timezone: UTC
    package_upgrade: false
    users:
      - name: flax
        primary_group: users
        groups: sudo
        lock_passwd: false
        passwd: "<<ubuntu_flax_hash>>"
        shell: /bin/bash
        ssh_authorized_keys:
          - "<<KEY>>"
        sudo: ALL=(ALL) NOPASSWD:ALL

      - name: pxadmin
        primary_group: users
        groups: sudo
        lock_passwd: false
        passwd: "<<ubuntu_pxadmin_hash>>"
        shell: /bin/bash
        ssh_authorized_keys:
          - "<<KEY>>"
        sudo: ALL=(ALL) NOPASSWD:ALL
