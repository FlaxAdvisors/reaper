  <bootloader t="map">
    <global t="map">
      <append>linux nomodeset noquiet splash=off console=tty0 console=ttyS1,57600n8
        earlyprintk=serial,ttyS1,57600n8 preempt=full mitigations=auto security=apparmor</append>
      <cpu_mitigations>auto</cpu_mitigations>
      <gfxmode>auto</gfxmode>
      <hiddenmenu>false</hiddenmenu>
      <os_prober>false</os_prober>
      <secure_boot>true</secure_boot>
      <serial>serial --unit=1 --speed=57600 --parity=no --word=8</serial>
      <terminal>gfxterm serial</terminal>
      <timeout t="integer">8</timeout>
      <update_nvram>true</update_nvram>
      <xen_append>console=hvc0</xen_append>
      <xen_kernel_append>console=com1 com1=57600</xen_kernel_append>
    </global>
    <loader_type>grub2-efi</loader_type>
  </bootloader>

  <general t="map">
    <mode t="map">
      <confirm t="boolean">false</confirm>
      <halt t="boolean">true</halt>
      <second_stage t="boolean">false</second_stage>
      <final_halt t="boolean">false</final_halt>
      <final_reboot t="boolean">false</final_reboot>
    </mode>
    <signature-handling t="map">
      <accept_file_without_checksum t="boolean">false</accept_file_without_checksum>
      <accept_non_trusted_gpg_key t="boolean">true</accept_non_trusted_gpg_key>
      <accept_unknown_gpg_key t="boolean">true</accept_unknown_gpg_key>
      <accept_unsigned_file t="boolean">true</accept_unsigned_file>
      <accept_verification_failed t="boolean">false</accept_verification_failed>
      <import_gpg_key t="boolean">true</import_gpg_key>
    </signature-handling>
  </general>

  <networking t="map">
    <dhcp_options t="map">
      <dhclient_client_id />
      <dhclient_hostname_option>AUTO</dhclient_hostname_option>
    </dhcp_options>
    <interfaces t="list">
      <interface t="map">
        <bootproto>dhcp</bootproto>
        <name>eth0</name>
        <startmode>auto</startmode>
      </interface>
      <interface t="map">
        <bootproto>dhcp</bootproto>
        <name>eth1</name>
        <startmode>auto</startmode>
      </interface>
    </interfaces>
    <ipv6 t="boolean">true</ipv6>
    <keep_install_network t="boolean">true</keep_install_network>
    <managed t="boolean">false</managed>
    <routing t="map">
      <ipv4_forward t="boolean">false</ipv4_forward>
      <ipv6_forward t="boolean">false</ipv6_forward>
    </routing>
  </networking>

  <firewall>
    <enable_firewall t="boolean">true</enable_firewall>
    <log_denied_packets>all</log_denied_packets>
    <default_zone>external</default_zone>
    <zones t="list">
      <zone>
        <name>external</name>
        <interfaces t="list">
          <interface>eth0</interface>
        </interfaces>
        <services t="list">
          <service>ssh</service>
          <service>dhcp</service>
          <service>dhcpv6</service>
          <service>samba</service>
          <service>vnc-server</service>
        </services>
        <ports t="list">
          <port>21/udp</port>
          <port>22/udp</port>
          <port>80/tcp</port>
          <port>443/tcp</port>
          <port>8080/tcp</port>
        </ports>
      </zone>
    </zones>
  </firewall>
  
  <ntp-client t="map">
    <ntp_policy>auto</ntp_policy>
    <ntp_servers t="list">
      <ntp_server t="map">
        <address>0.pool.ntp.org</address>
        <iburst t="boolean">true</iburst>
        <offline t="boolean">false</offline>
      </ntp_server>
      <ntp_server t="map">
        <address>1.pool.ntp.org</address>
        <iburst t="boolean">true</iburst>
        <offline t="boolean">false</offline>
      </ntp_server>
      <ntp_server t="map">
        <address>2.pool.ntp.org</address>
        <iburst t="boolean">true</iburst>
        <offline t="boolean">false</offline>
      </ntp_server>
      <ntp_server t="map">
        <address>3.pool.ntp.org</address>
        <iburst t="boolean">true</iburst>
        <offline t="boolean">false</offline>
      </ntp_server>
    </ntp_servers>
    <ntp_sync>systemd</ntp_sync>
  </ntp-client>

  <partitioning t="list">
    <drive t="map">
      <!--
        #  pci-0000:00:1f.2-ata-1   monolake
        #  pci-0000:00:1f.2-ata-5   leopard quanta
        #  pci-0000:00:1f.2-ata-3   bigsur bottom slot
        #  pci-0000:00:11.4-ata-1   bigsur top slot ???
        #  pci-0000:01:00.0-nvme-1  tiogapass
        #  pci-0000:00:04.0         vmware vm
      -->
      <device>/dev/disk/by-path/pci-0000:01:00.0-nvme-1</device>      
      <disklabel>gpt</disklabel>
      <enable_snapshots t="boolean">true</enable_snapshots>
      <type t="symbol">CT_DISK</type>
      <use>all</use>
    </drive>
  </partitioning>

  <report t="map">
    <errors t="map">
      <log t="boolean">true</log>
      <show t="boolean">false</show>
      <timeout t="integer">10</timeout>
    </errors>
    <messages t="map">
      <log t="boolean">false</log>
      <show t="boolean">false</show>
      <timeout t="integer">2</timeout>
    </messages>
    <warnings t="map">
      <log t="boolean">false</log>
      <show t="boolean">false</show>
      <timeout t="integer">2</timeout>
    </warnings>
    <yesno_messages t="map">
      <log t="boolean">false</log>
      <show t="boolean">false</show>
      <timeout t="integer">2</timeout>
    </yesno_messages>
  </report>

  <scripts t="map">
    <!--
    <init-scripts t="list">
      <script t="map">
        <filename>zzz_halt</filename>
        <source>shutdown -h now</source>
      </script>
    </init-scripts>
    -->
    <chroot-scripts config:type="list">
      <script>
        <chrooted config:type="boolean">true</chrooted>
        <filename>post.sh</filename>
        <interpreter>shell</interpreter>
        <source>
          <![CDATA[
#!/bin/bash

cat<<-'EOF'>/etc/sudoers.d/admin
admin ALL=(ALL) NOPASSWD: ALL
EOF
cat<<-'EOF'>/etc/sudoers.d/flax
flax ALL=(ALL) NOPASSWD: ALL
EOF
          ]]>
          </source>
      </script>
    </chroot-scripts>
  </scripts>

  <proxy t="map">
    <enabled t="boolean">false</enabled>
  </proxy>

  <services-manager t="map">
    <default_target>multi-user</default_target>
    <services t="map">
      <enable t="list">
        <service>sshd</service>
      </enable>
    </services>
  </services-manager>
  <software t="map">
    <install_recommended t="boolean">true</install_recommended>
