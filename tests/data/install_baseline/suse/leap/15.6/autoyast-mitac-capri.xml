  <partitioning config:type="list">
    <drive>
      <!--
        #  pci-0000:00:1f.2-ata-1   monolake
        #  pci-0000:00:1f.2-ata-5   leopard quanta
        #  pci-0000:00:1f.2-ata-3   bigsur bottom slot
        #  pci-0000:00:11.4-ata-1   bigsur top slot ???
        #  pci-0000:01:00.0-nvme-1  tiogapass
	#  pci-0000:05:00.0-nvme-1  mitac-tp
	#  pci-0000:47:00.0-ata-1   mitac-capri
        #  pci-0000:00:04.0         vmware vm
      -->

      <device>/dev/disk/by-path/pci-0000:47:00.0-ata-1</device>
      <disklabel>gpt</disklabel>
      <enable_snapshots config:type="boolean">true</enable_snapshots>
      <initialize config:type="boolean">false</initialize>
      <type config:type="symbol">CT_DISK</type>
      <use>all</use>
    </drive>
  </partitioning>
