# MAC-pinned + physical-only. SUBSYSTEMS=="pci" excludes vlan subifs
# (they share the parent MAC and would otherwise collide on the name).
# Reference copy (apply_jumphost does not deploy it): install by hand.
# Mellanox ConnectX (07:00) -> lab data (rabbit-lorax Et32/4 trunk, lab VLANs only)
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="pci", ATTR{address}=="0c:42:a1:19:ac:c2", KERNEL=="eth*", NAME="eth0"
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="pci", ATTR{address}=="0c:42:a1:19:ac:c3", KERNEL=="eth*", NAME="eth1"
# Mellanox ConnectX-4 Lx (01:00), 1GbE: mgmt -> turtle-lorax swp5 (VLAN 2), corp -> turtle-lorax swp46 (VLAN 4)
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="pci", ATTR{address}=="7c:fe:90:cb:74:3e", KERNEL=="eth*", NAME="mgmt"
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="pci", ATTR{address}=="7c:fe:90:cb:74:3f", KERNEL=="eth*", NAME="corp"
