#!/bin/bash
# bmc-clear-entity-cache -- drop EntityManager's cached configuration on a BMC.
#
# RENDERED FROM THE SITE VAULT by roles/apply_bmc_scripts. RULE ZERO: the value
# below is the BMC ROOT SHELL credential (NOT the credentials-bmc.json Redfish
# entry -- Redfish creds fail for ssh). It is never echoed, and sshpass -e keeps
# it out of argv and out of ps.
#
# WHY THIS EXISTS: /var/configuration/system.json caches the entity-manager
# configuration and SURVIVES A FIRMWARE FLASH. EntityManager loads it at boot,
# builds its model from it, then writes that model back -- so a cache describing
# the previous build perpetuates itself across an update, and a correctly
# flashed unit can still report stale sensors and SDR entries. Deleting the file
# forces a rebuild from the actual hardware on the next start.
#
# THE RESTART IS LOAD-BEARING WHEN THIS RUNS AS A SINGLETON. EntityManager
# writes its in-memory model back to system.json on its own (seen 2026-09-11 on
# 172.17.7.101: mtime advancing on a BMC up for 15 h), so an `rm` alone is undone
# within minutes unless something restarts the service -- an operator running
# this by hand got nothing. The unit is Type=dbus, so `systemctl restart` returns
# only once EntityManager owns its bus name again; the echoed RESTARTED token
# therefore means "up and rebuilding from hardware", not merely "asked". The
# pre-flash callers (bmcfw, biosfw) key on "cleared" alone -- for them the
# restart is a few-second sensor blip on a BMC about to reboot anyway.
#
#   clear <bmc-ip>   ->  {"cleared":true,"restarted":true}
#                    ->  {"cleared":true,"restarted":false}   rm ran, restart did
#                                                             not; exit 1
#                    ->  {"error":"ssh_unreachable"} | {"error":"rm_failed"}
set -u

EM_UNIT=xyz.openbmc_project.EntityManager.service

export SSHPASS={{ bmc_root_password | quote }}
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10"

# Remote executor. FLAX_BMC_REMOTE_EXEC lets the test suite run the same command
# against a fixture instead of a real BMC; production leaves it unset and goes
# over ssh. Same shape as bios_gate_report.sh's FLAX_CMDLINE_FILE hook.
bmc() {
    if [ -n "${FLAX_BMC_REMOTE_EXEC:-}" ]; then
        "$FLAX_BMC_REMOTE_EXEC" "$1" "$2"
        return $?
    fi
    sshpass -e ssh -n -T $SSH_OPTS "root@$1" "$2"
}

json_err() { printf '{"error":"%s"}\n' "$1"; exit 1; }

cmd_clear() {
    ip="$1"
    # `rm -f` is idempotent on purpose: a unit with no cache is already in the
    # desired state, and a firmware update must never fail for want of something
    # to delete. The echoed token is load-bearing -- without it a successful
    # no-op and an unreachable BMC both produce empty output and could not be
    # told apart, and the caller records a reason on failure.
    # One ssh session for both steps; each echoes its own token so the caller
    # can tell "cleared but EntityManager did not come back" from "never got
    # there". Read the tokens BEFORE the exit status: a failed restart makes the
    # chain non-zero, and that must not be mistaken for an unreachable BMC.
    out=$(bmc "$ip" "rm -f /var/configuration/system.json && echo CLEARED \
        && systemctl restart $EM_UNIT && systemctl is-active --quiet $EM_UNIT \
        && echo RESTARTED")
    rc=$?
    case "$out" in
        *CLEARED*RESTARTED*) printf '{"cleared":true,"restarted":true}\n' ;;
        *CLEARED*)           printf '{"cleared":true,"restarted":false}\n'; exit 1 ;;
        *)  [ "$rc" -ne 0 ] && json_err ssh_unreachable
            json_err rm_failed ;;
    esac
}

case "${1:-}" in
    clear)
        [ $# -eq 2 ] || { echo "usage: bmc-clear-entity-cache clear <bmc-ip>" >&2; exit 2; }
        cmd_clear "$2" ;;
    *) echo "usage: bmc-clear-entity-cache clear <bmc-ip>" >&2; exit 2 ;;
esac
