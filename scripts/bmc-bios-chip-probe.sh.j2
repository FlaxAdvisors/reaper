#!/bin/bash
# bmc-bios-chip-probe -- is the HOST BIOS SPI chip (pnor) blank?
#
# RENDERED FROM THE SITE VAULT by roles/apply_bmc_scripts. The password below
# is the BMC ROOT SHELL credential, NOT the credentials-bmc.json Redfish
# entry. RULE ZERO: never echo it. sshpass -e keeps it out of argv and ps.
#
# The host BIOS flash is spi1.0 ("pnor") on 1e630000.spi, MUXED between the
# BMC and the PCH by GPIO N5 (BIOS_SPI_BMC_CTRL). At rest the mux is at PCH,
# the JEDEC probe reads all-zeros, and spi-nor does not bind -- so there is no
# pnor MTD to read. The sequence below is taken verbatim from the BMC's own
# /usr/sbin/bios-update; the only difference is that this reads and never
# writes.
#
# WHY THE MUX MATTERS MORE THAN THE READ: leaving the mux at BMC makes the
# host unbootable. The EXIT trap returns it on every path that actually took
# the bus, and success is not reported until the GPIO reads back at PCH --
# read BEFORE the export directory is torn down, never assumed from its
# absence (a torn-down/absent readback is mux_stuck, never PCH; see
# restore_bus below).
#
#   probe <bmc-ip>  -> {"chip":"populated"|"blank"|"bootblock_blank"}
#
# Errors as {"error":"<code>"}: ssh_unreachable, host_not_off, bind_failed,
# chip_absent, read_failed, mux_stuck.
#
# CONTRACT with bmcfw.worker: no failure path may emit a "chip" key --
# bios_chip.state_from takes the FIRST record carrying one.
set -u

# I7: NO surrounding quotes -- ansible's `quote` filter emits its own, correctly,
# for any value. Hand-wrapping in single quotes breaks (or worse: runs shell)
# the moment a vaulted password contains a single quote of its own. RULE ZERO
# holds either way: the rendered value is never echoed.
export SSHPASS={{ bmc_root_password | quote }}
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10"

# 32 MiB / 64 KiB = 512 blocks. Overridable ONLY so the test suite can use a
# small fixture; production always computes it from the registered MTD size.
# This NEVER substitutes for the size-plausibility check below -- it only
# changes how many 64 KiB blocks are addressed once a plausible chip is found.
PROBE_BLOCKS="${FLAX_PROBE_BLOCKS:-0}"

# Plausible pnor sizes: 16 MiB .. 128 MiB. Anything else means we are not
# reading the device we think we are -- report chip_absent, never a verdict.
# This check runs UNCONDITIONALLY: PROBE_BLOCKS overrides only the block
# count used for reading, never whether the size looks like a real chip.
MIN_SIZE=16777216
MAX_SIZE=134217728

# Remote executor. FLAX_BMC_REMOTE_EXEC lets the test suite point this at a
# stub that runs the same pipeline against fixture files instead of a real BMC;
# production always leaves it unset and goes over ssh. Same shape as
# bmc-backup-flash.sh.j2's FLAX_BMC_REMOTE_EXEC hook.
bmc() {
    if [ -n "${FLAX_BMC_REMOTE_EXEC:-}" ]; then
        "$FLAX_BMC_REMOTE_EXEC" "$1" "$2"
        return $?
    fi
    sshpass -e ssh -n -T $SSH_OPTS "root@$1" "$2"
}

json_err() { printf '{"error":"%s"}\n' "$1"; exit 1; }

IP=""

# _bus_taken is set ONLY by take_bus, once the mux/bind sequence has actually
# been sent. ssh_unreachable and host_not_off exit before that ever happens,
# so restore_bus below must never touch a bus it never took (review finding:
# "the EXIT trap mutates the bus on paths that never took it").
_bus_taken=0
_mux_confirmed=0

take_bus() {
    _bus_taken=1
    bmc "$IP" '
        B=$(sort -n /sys/class/gpio/gpiochip*/base 2>/dev/null | head -n 1)
        G=$((B + 109))
        [ -d /sys/class/gpio/gpio$G ] || echo $G > /sys/class/gpio/export
        echo out > /sys/class/gpio/gpio$G/direction
        echo 1   > /sys/class/gpio/gpio$G/value
        sleep 1
        SPI=/sys/bus/platform/drivers/spi-aspeed-smc
        [ -e "$SPI/1e630000.spi" ] && { echo -n 1e630000.spi > "$SPI/unbind"; sleep 1; }
        echo -n 1e630000.spi > "$SPI/bind"
        sleep 2
    ' >/dev/null 2>&1
}

# Unbind, mux back to PCH, and PROVE it landed there -- all in ONE remote
# call, reading the GPIO value BEFORE it is unexported. Review finding
# (Critical): the previous version unexported first and read back after,
# so a successful cleanup always made the directory disappear and the
# readback's "else echo 0" branch fired every time -- "GPIO absent" was
# silently read as "mux at PCH", which is exactly the conflation this bin
# exists to avoid. Here, "cannot read" (absent, empty, non-numeric) is
# never treated as PCH; only a literal "0" readback counts.
#
# Retries a few times (review finding: the trap must not be a no-op on the
# one path where the mux is known wrong) before giving up. Idempotent: once
# confirmed, later calls (the EXIT trap after an explicit call already
# succeeded) are free.
restore_bus() {
    [ "$_bus_taken" = 1 ] || return 0
    [ "$_mux_confirmed" = 1 ] && return 0
    i=1
    while [ "$i" -le 3 ]; do
        val=$(bmc "$IP" '
            SPI=/sys/bus/platform/drivers/spi-aspeed-smc
            [ -e "$SPI/1e630000.spi" ] && echo -n 1e630000.spi > "$SPI/unbind" 2>/dev/null
            B=$(sort -n /sys/class/gpio/gpiochip*/base 2>/dev/null | head -n 1)
            G=$((B + 109))
            if [ -d /sys/class/gpio/gpio$G ]; then
                echo 0  > /sys/class/gpio/gpio$G/value     2>/dev/null
                echo in > /sys/class/gpio/gpio$G/direction 2>/dev/null
                cat /sys/class/gpio/gpio$G/value 2>/dev/null
                echo $G > /sys/class/gpio/unexport         2>/dev/null
            else
                echo absent
            fi
        ' 2>/dev/null | tr -d '\r ')
        if [ "$val" = 0 ]; then
            _mux_confirmed=1
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}
# Best-effort last resort on every exit path: a no-op if the bus was never
# taken or was already confirmed restored; otherwise one more retry burst.
trap 'restore_bus >/dev/null 2>&1' EXIT

# Read ONE 64 KiB window with ONE dd invocation, then measure the SAME bytes
# TWICE (raw byte count, and non-0xFF byte count) in that same remote round
# trip, via a temp file under /tmp (tmpfs on the BMC), removed
# UNCONDITIONALLY by a remote trap.
#
# Reading the window with TWO SEPARATE dd calls (one to size-check, one to
# compute the verdict) was tried and rejected (review finding, Critical --
# demonstrated reachable twice): the size-checked read and the
# verdict-computing read were then two INDEPENDENT reads of the same region,
# so a runtime dd failure (EIO, device busy, the mux slipping between round
# trips) in the SECOND read alone was invisible to the first read's size
# check -- the exact original bug, one call later. Splitting the read in two
# also doubled the mux's exposure window. One dd, two measurements, the same
# bytes, closes both problems at once.
#
# The trap fires on EXIT, INT, TERM, AND HUP -- NOT "EXIT" alone (review
# finding, minor). This shell is BusyBox ash on the BMC, not bash: verified
# with dash that "trap ... EXIT" alone does not fire for an untrapped fatal
# signal -- SIGHUP, SIGTERM and SIGINT all leak the file. An ssh drop is
# precisely SIGHUP, and /tmp is tmpfs on a 489 MB board.
#
# nff is measured over `{ printf 'X'; cat "$f"; } | tr -d '\377' | wc -c`,
# NOT bare `tr -d '\377' < "$f" | wc -c` (review finding, Important -- a
# route neither of the prior two rounds closed). The raw-byte-count gates
# above only prove dd's OWN read was complete; they say nothing about the
# tr stage that actually measures it. If dd succeeds perfectly but tr itself
# fails to run or is killed with zero output (exec failure, an OOM kill on
# this board), wc counts an empty pipe and prints a clean numeric "0" --
# raw is still 65536, the size gate passes, and the verdict is "blank": a
# MEASUREMENT failure, not a READ failure, reaching the same false verdict
# by a different route. The prepended sentinel byte ('X', never 0xFF, so
# tr -d '\377' never strips it) makes a zero count structurally impossible
# for a pipeline that actually ran to completion: a correct run always
# emits at least "1" (the sentinel alone, for an all-0xFF window). The
# caller requires nff >= 1 and subtracts 1 to recover the true non-0xFF
# count.
read_window() {  # $1 = extra dd args, e.g. "" for the head window or "skip=$top" for the top window
    bmc "$IP" "f=/tmp/.bcp.\$\$
trap 'rm -f \"\$f\"' EXIT INT TERM HUP
dd if=$dev bs=64k count=1 $1 2>/dev/null > \"\$f\"
raw=\$(wc -c < \"\$f\" 2>/dev/null)
nff=\$({ printf 'X'; cat \"\$f\"; } 2>/dev/null | tr -d '\\377' | wc -c)
printf '%s %s' \"\$raw\" \"\$nff\"" 2>/dev/null | tr -d '\r'
}

cmd_probe() {
    IP="$1"

    # 1. The host MUST be off. Belt and braces: the worker checks this too,
    #    but the bin must never assume its caller got it right.
    state=$(bmc "$IP" 'obmcutil state 2>/dev/null | sed -n "s/.*CurrentPowerState *: *//p"' 2>/dev/null)
    [ -n "$state" ] || json_err ssh_unreachable
    case "$state" in
        *Off*) ;;
        *) json_err host_not_off ;;
    esac

    # 2. Take the bus: mux to BMC, then unbind/rebind so JEDEC re-probes.
    take_bus

    # 3. Find the pnor MTD. Its mere registration is the CANARY: it proves
    #    JEDEC answered, which proves the mux switched. At PCH nothing binds,
    #    so "no pnor" and "blank chip" stay structurally distinguishable.
    mtd=""
    i=1
    while [ "$i" -le 5 ]; do
        mtd=$(bmc "$IP" 'for f in /sys/class/mtd/mtd*/name; do
                  [ "$(cat "$f" 2>/dev/null)" = pnor ] && basename "$(dirname "$f")" && break
              done' 2>/dev/null | tr -d '\r')
        [ -n "$mtd" ] && break
        sleep 2
        i=$((i + 1))
    done
    [ -n "$mtd" ] || json_err bind_failed

    # Shape-guard $mtd before it goes anywhere near a remote command string:
    # it is untrusted remote output (review finding, minor). It is always
    # interpolated as a bare device suffix, never quoted into a value that
    # could itself contain shell metacharacters, so a strict "mtdN" shape
    # check is sufficient here (unlike bmc-backup-flash.sh.j2's _sq(), which
    # guards a value that IS placed inside quotes).
    case "$mtd" in
        mtd*) mtd_n=${mtd#mtd} ;;
        *)    mtd_n="" ;;
    esac
    case "$mtd_n" in
        ''|*[!0-9]*) json_err bind_failed ;;
    esac

    # Read-only node preference (review finding, minor; confirmed live against
    # 172.17.10.101 by the coordinator): this BMC image exposes /dev/mtd<N>ro
    # alongside /dev/mtd<N> for every MTD -- a free never-write guarantee at
    # the device-node level. Prefer it, but NEVER require it: pnor only
    # exists during the mux window, so its ro twin cannot be verified ahead
    # of time, and a hard dependency on an unconfirmed node would turn a
    # safety nicety into an outage. Test for it and fall back to the plain
    # node if it is absent -- the read-only guarantee then falls back to what
    # it always was: this bin only ever pipes the device through dd|tr|wc
    # (count only, never `of=`) -- see the read step below.
    dev="/dev/mtd$mtd_n"
    ro_dev="${dev}ro"
    if [ "$(bmc "$IP" "[ -e $ro_dev ] && echo yes" 2>/dev/null | tr -d '\r ')" = yes ]; then
        dev="$ro_dev"
    fi

    # 4. Plausible size, or we are misreading the device. UNCONDITIONAL: never
    #    gated on PROBE_BLOCKS, which only ever overrides the block count below.
    size=$(bmc "$IP" "cat /sys/class/mtd/$mtd/size 2>/dev/null" 2>/dev/null | tr -d '\r ')
    case "$size" in ''|*[!0-9]*) json_err chip_absent ;; esac
    [ "$size" -ge "$MIN_SIZE" ] && [ "$size" -le "$MAX_SIZE" ] || json_err chip_absent

    blocks="$PROBE_BLOCKS"
    [ "$blocks" -gt 0 ] || blocks=$((size / 65536))
    top=$((blocks - 1))

    # 5. Two 64 KiB windows, each via ONE dd read measured twice (see
    #    read_window above -- one dd, two measurements, the same bytes, plus
    #    a sentinel byte that makes a healthy measurement's count structurally
    #    nonzero). NEVER sample the middle: a HEALTHY image has 12 MiB of
    #    all-0xFF interior (spec 2.5), so an interior window reads blank on a
    #    good chip.
    #
    #    Two independent gates, both checked BEFORE the non-0xFF count is
    #    trusted:
    #      - the raw count must be exactly 65536 (short, zero, or non-numeric
    #        -- ssh drop, EIO, device busy, a stale ro node) -- a READ
    #        failure, never a verdict.
    #      - the measured (sentinel-inclusive) count must be >= 1 -- a
    #        MEASUREMENT failure (tr itself failing to run, or killed with
    #        zero output, despite a perfectly good dd) is structurally
    #        impossible for a healthy pipeline once the sentinel is counted,
    #        so a numeric 0 here can only mean the pipeline never completed.
    #    Either failure is read_failed, never a blank chip. Same principle as
    #    bmc-backup-flash.sh.j2's cmd_version distinguishing read_failed from
    #    a value rather than guessing one.
    result=$(read_window "")
    head_raw=${result%% *}
    head_nff=${result#* }
    case "$head_raw" in ''|*[!0-9]*) json_err read_failed ;; esac
    [ "$head_raw" -eq 65536 ] || json_err read_failed
    case "$head_nff" in ''|*[!0-9]*) json_err read_failed ;; esac
    [ "$head_nff" -ge 1 ] || json_err read_failed
    head_n=$((head_nff - 1))

    result=$(read_window "skip=$top")
    top_raw=${result%% *}
    top_nff=${result#* }
    case "$top_raw" in ''|*[!0-9]*) json_err read_failed ;; esac
    [ "$top_raw" -eq 65536 ] || json_err read_failed
    case "$top_nff" in ''|*[!0-9]*) json_err read_failed ;; esac
    [ "$top_nff" -ge 1 ] || json_err read_failed
    top_n=$((top_nff - 1))

    # 6. Release the bus and PROVE it went back, before reporting anything.
    restore_bus || json_err mux_stuck

    # 7. Verdict. The top block is the x86 reset vector: erased means the host
    #    cannot boot, whatever else the chip holds.
    if [ "$top_n" -gt 0 ]; then
        printf '{"chip":"populated"}\n'
    elif [ "$head_n" -gt 0 ]; then
        printf '{"chip":"bootblock_blank"}\n'
    else
        printf '{"chip":"blank"}\n'
    fi
}

case "${1:-}" in
    probe) [ $# -eq 2 ] || { echo "usage: bmc-bios-chip-probe probe <bmc-ip>" >&2; exit 2; }; cmd_probe "$2" ;;
    *) echo "usage: bmc-bios-chip-probe probe <bmc-ip>" >&2; exit 2 ;;
esac
