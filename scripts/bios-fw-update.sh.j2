#!/bin/bash
# bios-fw-update -- push a host BIOS image to a TiogaPass OpenBMC over Redfish,
# follow the job, and report what the BMC's own /usr/sbin/bios-update did.
#
# RENDERED FROM THE SITE VAULT by roles/apply_bmc_scripts. RULE ZERO: the value
# below is the BMC root credential from the vaulted credentials-bmc.json (root
# entry). It is used for Redfish (via a netrc fed to curl on stdin -- no
# process-substitution child, so nothing is left for PID 1 to reap) and for
# the BMC root shell (sshpass -e). It never appears in argv, ps or output.
#
#   bios-fw-update version <bmc-ip>
#       -> bios_active Version (empty on failure)
#   bios-fw-update busy <bmc-ip>
#       -> {"busy":bool,"reason":...,"task_id":...,...}; exit 0 idle, 3 busy
#   bios-fw-update flash <bmc-ip> <artifact-url> [--port <et25b1>]
#       --port: holds the manual claim /run/flax/bmc-fw-manual/<port> for the
#       run and touches /run/flax/bmc-reboot/<port> when the task Completes.
#       -> JSON progress lines, then one {"phase":"verdict",...} record
#   bios-fw-update journal <bmc-ip> <since-epoch>
#       -> {"phase":"journal","bios_update":[...],"power_control":[...],
#           "entity_manager":[...]}; exit 0, or {"error":"ssh_unreachable"} exit 1
#       R4 (09-23 spec §11): the diagnosis reads these BEFORE any recovery action.
#
# Exit codes: 0 the BMC job completed (read the verdict for what that means);
#             1 failure; 2 usage; 3 INTERLOCK -- nothing was pushed.
#
# WHY THIS EXISTS (2026-09-24). The same bios-update runs whether the image
# arrives from the WebUI, a manual Redfish push or bios_fw. What differed was
# everything around it:
#   * THE INTERLOCK. A push is refused while any update job on the BMC is live,
#     or ended less than QUIET_S ago -- bios-update's ME-changed branch fires
#     its HSC cut 20 s AFTER its job completes. A 423 (HttpPushUriTargetsBusy)
#     is treated as busy. This bin NEVER clears that flag: forcing it and
#     pushing again can start a second bios-update on the same chip, and the
#     first to finish returns the SPI mux under the other's flashcp.
#   * THE VERDICT. The Redfish Task reads "Completed" whether the host came up
#     or not. bios-update states the truth only in the BMC journal, which is
#     volatile (4 MiB, ~15 min). It is read here, immediately, and emitted.
#   * THE CUT CHECK. On the ME-changed branch bios-update schedules
#     `i2cset -f -y 7 0x45 0xd9 0x0c`. That was observed NOT to cut power
#     (et25b4 13:58, et26b3 18:03 on 2026-09-24: same BMC boot straight through).
#     This bin reports whether the BMC actually went down; it takes NO power
#     action itself. Recovery belongs to bios_fw.
# Design: reaper-devel docs/superpowers/specs/2026-09-24-fw-agents-latch-and-
# bootcheck-move-design.md.
set -uo pipefail

# Kill every descendant of $1: FREEZE the whole subtree first (SIGSTOP,
# depth-first) so a still-running parent cannot spawn a new child while we
# are mid-walk, then TERM + CONT each node, deepest first. Command
# substitutions and pipelines run in subshells that a plain `kill $$` does
# not reach; a killed bin must never leave an ssh or journal read behind
# holding the per-BMC lock (et6b4 2026-09-27: >1 h).
kill_tree() {
    local c
    [ "$1" != "$$" ] && kill -STOP "$1" 2>/dev/null
    for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done
    [ "$1" != "$$" ] && { kill -TERM "$1" 2>/dev/null; kill -CONT "$1" 2>/dev/null; }
    return 0
}
# 2026-09-27 fix round 2 (Review Focus 2, N1/N2): this bin now runs as TWO
# processes. The PARENT (the pid callers see, at the very bottom of this
# file) parses argv, runs need_lock_dir, and -- for `flash`, the only
# subcommand that locks -- takes the per-BMC flock on fd 9 ITSELF, then
# re-execs its own body as a CHILD (`FLAX_BIN_CHILD=1 setpriv --pdeathsig
# KILL "$0" "$@" 9>&-`) that never sees fd 9 and never takes the lock
# again. `on_signal` (PARENT only) freezes and kills the CHILD's whole
# subtree; `--pdeathsig KILL` makes the kernel SIGKILL the child the
# instant the PARENT dies for ANY reason, including a SIGKILL to the
# PARENT itself, which no trap can catch. Round 1's `main "$@" & wait`
# looked similar but forked a SUBSHELL of the SAME process (not a real
# child), so SIGKILL of the bin pid left that subshell alive, holding the
# lock, running to completion -- for bmc-blade-power-cycle that meant a
# 12 V cut was still sent after the caller had already given up (N2). This
# design ties the lock's fate to the PARENT process's own survival: fd 9
# is only ever open in the PARENT, so it closes the instant the PARENT
# exits, however that happens.
on_signal() {
    trap - TERM INT HUP
    kill_tree "$CHILD"
    # 2026-09-27 fix round 3, M1: wait (bounded) for the child to actually
    # exit before this process does. Without this, `exit 143` here races
    # the child's OWN TERM trap cleanup (`rm -f "$ART"`) against the
    # `--pdeathsig` SIGKILL the kernel delivers to the child the instant
    # THIS process exits -- measured: $ART survived in 3 of 6 runs. The
    # child is already frozen+killed by kill_tree above, so this loop is
    # normally a couple of 0.1s ticks, never the full 2s.
    local w
    for w in $(seq 1 20); do kill -0 "$CHILD" 2>/dev/null || break; sleep 0.1; done
    hb_stop
    claim_release   # Task 3: the manual claim goes with the lock
    exit 143
}

# ── manual-run claim + BMC reboot marker (2026-09-27, part1 Task 3) ──────────
# CLAIM. Reconcile defers every action on a port while a fw bin runs on it.
# A bin's claim is /run/flax/bmc-fw-manual/<port> -- NOT bmc-fw-active/<port>,
# which is bmc_fw's own (days-long) claim and which no bin ever touches. The
# PARENT (the lock holder) writes it right after taking the per-BMC lock and
# removes it on normal exit and on TERM/INT/HUP, so it lives and dies with
# the lock. It is a HEARTBEAT: the PARENT re-touches it every HEARTBEAT_S
# (60 s) from its wait loop while it lives, and reconcile honours it only
# while now - mtime < 180 s -- so a flash of any length stays protected, and
# a SIGKILLed bin's claim (which nothing can remove) goes stale within 3 min
# because nothing is left to touch it. Content is "<parent pid>@<host>"; on exit a bin removes the
# file only if it still holds its OWN token (two IPs mapping to one port can
# race; the per-BMC lock serialises runs per IP only). A stale claim from a
# dead run is simply overwritten.
# (Every external command here closes fd 9: the PARENT holds the lock.)
# REBOOT MARKER. /run/flax/bmc-reboot/<port>, touched by whichever process
# sends a reboot-causing action; its mtime is the reboot time, from which
# reconcile gives the port a boot-grace window (no switch_flap mid-boot).
MANUAL_CLAIM_DIR="${FLAX_MANUAL_CLAIM_DIR:-/run/flax/bmc-fw-manual}"
REBOOT_DIR="${FLAX_REBOOT_DIR:-/run/flax/bmc-reboot}"
HEARTBEAT_S="${FLAX_CLAIM_HEARTBEAT_S:-60}"
CLAIM_FILE=""; CLAIM_TOKEN=""; HB_PID=""
# A port becomes a file name: accept only the internal port form's alphabet.
port_ok() { [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
# arg_port <argv...> -> the value of the LAST --port (the child's parser
# also keeps the last, so claim and marker always name the same port); a
# following token that starts with "--" is a flag, not a value -> "".
arg_port() {
    local v=""
    while [ $# -gt 0 ]; do
        if [ "$1" = --port ]; then
            case "${2:-}" in --*|"") v="" ;; *) v="$2"; shift ;; esac
        fi
        shift
    done
    printf '%s' "$v"
}
claim_take() {   # claim_take <port> -- PARENT only, after take_lock
    [ -n "${1:-}" ] || return 0
    port_ok "$1" || { echo "claim: ignoring malformed port '$1'" >&2; return 0; }
    mkdir -p "$MANUAL_CLAIM_DIR" 2>/dev/null 9>&- || { echo "claim: cannot create $MANUAL_CLAIM_DIR; running unclaimed" >&2; return 0; }
    CLAIM_TOKEN="$$@${HOSTNAME:-$(cat /proc/sys/kernel/hostname 2>/dev/null)}"
    if printf '%s\n' "$CLAIM_TOKEN" > "$MANUAL_CLAIM_DIR/$1" 2>/dev/null; then
        CLAIM_FILE="$MANUAL_CLAIM_DIR/$1"
    else
        echo "claim: cannot write $MANUAL_CLAIM_DIR/$1; running unclaimed" >&2
    fi
    return 0
}
claim_release() {   # PARENT only; removes the claim only if it is still ours
    [ -n "$CLAIM_FILE" ] || return 0
    [ "$(cat "$CLAIM_FILE" 2>/dev/null 9>&-)" = "$CLAIM_TOKEN" ] && rm -f "$CLAIM_FILE" 9>&-
    CLAIM_FILE=""
    return 0
}
claim_heartbeat() {   # PARENT, from its wait loop: move the claim's mtime
    [ -n "$CLAIM_FILE" ] || return 0
    if [ -e "$CLAIM_FILE" ]; then touch -c "$CLAIM_FILE" 2>/dev/null 9>&-
    else printf '%s\n' "$CLAIM_TOKEN" > "$CLAIM_FILE" 2>/dev/null; fi   # re-claim if another run's exit removed it
    return 0
}
# The ticker that wakes the PARENT's `wait` every HEARTBEAT_S: a separate
# process that sends this PARENT a (trapped, no-op) USR1. The PARENT does the
# touching itself, so once the PARENT is gone nothing touches the claim. The
# ticker dies with the PARENT (--pdeathsig KILL; its own $PPID check closes
# the fork-to-prctl window exactly as the CHILD's marker check does), and
# never holds fd 9 or the caller's stdout/stderr.
hb_start() {   # PARENT only, after the CHILD is spawned
    [ -n "$CLAIM_FILE" ] || return 0
    trap ':' USR1   # before the ticker exists: an untrapped USR1 would kill us
    # The sleep runs in the BACKGROUND under a TERM trap that kills it, so
    # hb_stop never leaves an orphaned `sleep` (re-parented to PID 1 -- a
    # zombie under a non-reaping init; cf. the 2026-09-25 pids-max incident).
    FLAX_HB_PARENT=$$ setpriv --pdeathsig KILL bash -c \
        'p=$FLAX_HB_PARENT; [ "$PPID" = "$p" ] || exit 0; s=""
         trap '"'"'[ -n "$s" ] && kill "$s" 2>/dev/null; exit 0'"'"' TERM
         while :; do sleep "$1" & s=$!; wait "$s" || exit 0; s=""; kill -USR1 "$p" 2>/dev/null || exit 0; done' _ "$HEARTBEAT_S" \
        </dev/null >/dev/null 2>&1 9>&- &
    HB_PID=$!
}
hb_stop() {   # belt and braces: the ticker's own sleep first, then the ticker
    [ -n "$HB_PID" ] && { pkill -P "$HB_PID" 2>/dev/null 9>&-; kill "$HB_PID" 2>/dev/null; }
    HB_PID=""; return 0
}
mark_reboot() {   # mark_reboot <port> -- touch, so an existing marker's mtime moves too
    port_ok "${1:-}" || return 0
    mkdir -p "$REBOOT_DIR" 2>/dev/null 9>&- && touch "$REBOOT_DIR/$1" 2>/dev/null 9>&-
    return 0
}

export SSHPASS={{ bmc_root_password | quote }}
RF_USER=root

QUIET_S="${BIOS_FW_UPDATE_QUIET_S:-60}"          # after a job ends
POLL_S="${BIOS_FW_UPDATE_POLL_S:-5}"
TASK_WAIT_S="${BIOS_FW_UPDATE_TASK_WAIT_S:-900}"
POLL_FAIL_MAX="${BIOS_FW_UPDATE_POLL_FAIL_MAX:-12}"
CUT_WAIT_S="${BIOS_FW_UPDATE_CUT_WAIT_S:-75}"    # 20 s timer + margin
CUT_POLL_S="${BIOS_FW_UPDATE_CUT_POLL_S:-5}"
LOCK_DIR="${BIOS_FW_UPDATE_LOCK_DIR:-/run/flax}"
JOURNAL_FETCH_S="${BIOS_FW_UPDATE_JOURNAL_FETCH_S:-120}"  # F5: bound the post-flash journal/busctl read
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10 -o HostKeyAlgorithms=+ssh-rsa"
export SSH_OPTS   # journal_fetch's `bash -c` child (a fresh shell) needs this

# ── transport (each has a test hook; production leaves the hooks unset) ──────

# rf <METHOD> <ip> <path> [curl args...] -> body, then a final line HTTP=<code>
rf() {
    local method="$1" ip="$2" path="$3"; shift 3
    if [ -n "${FLAX_REDFISH_EXEC:-}" ]; then
        "$FLAX_REDFISH_EXEC" "$method" "$path" "$@" 9>&-
        return $?
    fi
    # No caller passes a request body on stdin (uploads use -F @file / a
    # tempfile path), so the netrc can safely ride curl's own stdin -- no
    # process substitution, no child process for PID 1 to reap.
    # 9>&- (2026-09-27): curl must never inherit the per-BMC lock fd -- a
    # SIGKILL'd bin (or one whose curl outlives it for any other reason)
    # must not leave an orphan holding the flock.
    curl -sk --netrc-file /dev/stdin \
        --connect-timeout 6 --max-time "${RF_MAX_TIME:-15}" -X "$method" \
        -w '\nHTTP=%{http_code}' "https://${ip}${path}" "$@" \
        <<<"machine $ip login $RF_USER password $SSHPASS" 9>&-
}

bmc() {   # bmc <ip> <remote command>
    # 9>&- (2026-09-27): same reasoning as rf()'s curl -- ssh must never
    # inherit the per-BMC lock fd.
    if [ -n "${FLAX_BMC_REMOTE_EXEC:-}" ]; then
        "$FLAX_BMC_REMOTE_EXEC" "$1" "$2" 9>&-
        return $?
    fi
    sshpass -e ssh -n -T $SSH_OPTS "root@$1" "$2" 9>&-
}
export -f bmc   # journal_fetch's `bash -c` child (a fresh shell) needs this

fetch() {  # fetch <url> <out>
    if [ -n "${FLAX_FETCH_EXEC:-}" ]; then
        "$FLAX_FETCH_EXEC" "$1" "$2" 9>&-
        return $?
    fi
    curl -fsSL --max-time 300 -o "$2" "$1" 9>&-
}

now_s() { if [ -n "${FLAX_NOW:-}" ]; then echo "$FLAX_NOW"; else date +%s; fi; }
nap()   { [ "${1:-0}" -gt 0 ] 2>/dev/null && sleep "$1"; return 0; }

body_of() { sed '$d'; }                                   # strip HTTP= line
code_of() { tail -n 1 | sed -n 's/^HTTP=//p'; }

emit() {  # emit <phase> <percent> <task_id> <state> [reason]
    printf '{"phase":"%s","percent":%s,"task_id":"%s","state":"%s","reason":"%s"}\n' \
        "$1" "${2:-0}" "${3:-}" "${4:-}" "${5:-}"
}

# ── the interlock ─────────────────────────────────────────────────────────────

# Prints one JSON verdict; returns 0 idle, 3 busy. Unreadable = busy (fail closed).
busy_check() {
    local ip="$1" coll ids docs="[" first=1 id t
    coll=$(rf GET "$ip" /redfish/v1/TaskService/Tasks)
    if [ "$(printf '%s' "$coll" | code_of)" != "200" ]; then
        printf '{"busy":true,"reason":"tasks_unreadable"}\n'; return 3
    fi
    ids=$(printf '%s' "$coll" | body_of | python3 -c '
import sys, json
try:
    for m in json.load(sys.stdin).get("Members", []):
        print(m.get("@odata.id", "").rstrip("/").rsplit("/", 1)[-1])
except Exception:
    print("__UNREADABLE__")')
    case "$ids" in *__UNREADABLE__*) printf '{"busy":true,"reason":"tasks_unreadable"}\n'; return 3;; esac
    for id in $ids; do
        t=$(rf GET "$ip" "/redfish/v1/TaskService/Tasks/$id")
        if [ "$(printf '%s' "$t" | code_of)" != "200" ]; then
            printf '{"busy":true,"reason":"tasks_unreadable","task_id":"%s"}\n' "$id"; return 3
        fi
        [ $first = 1 ] || docs="$docs,"; first=0
        docs="$docs$(printf '%s' "$t" | body_of)"
    done
    docs="$docs]"
    printf '%s' "$docs" | NOW="$(now_s)" QUIET="$QUIET_S" python3 -c '
import sys, json, os, re, calendar, time
now = float(os.environ["NOW"]); quiet = float(os.environ["QUIET"])
LIVE = {"New", "Starting", "Running", "Pending", "Stopping", "Suspended",
        "Interrupted", "Cancelling", "Service"}
def epoch(s):
    m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.\d+)?(Z|[+-]\d\d:\d\d)?$", s or "")
    if not m:
        return None
    t = calendar.timegm(time.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S"))
    tz = m.group(2)
    if tz and tz != "Z":
        sign = 1 if tz[0] == "+" else -1
        t -= sign * (int(tz[1:3]) * 3600 + int(tz[4:6]) * 60)
    return t
try:
    tasks = json.loads(sys.stdin.read())
except Exception:
    print(json.dumps({"busy": True, "reason": "tasks_unreadable"})); sys.exit(3)
for t in tasks:
    if t.get("TaskState") in LIVE:
        print(json.dumps({"busy": True, "reason": "job_running", "task_id": t.get("Id"),
                          "state": t.get("TaskState"), "percent": t.get("PercentComplete")}))
        sys.exit(3)
latest = None
for t in tasks:
    e = epoch(t.get("EndTime"))
    if e is not None and (latest is None or e > latest[0]):
        latest = (e, t)
if latest and now - latest[0] < quiet:
    e, t = latest
    print(json.dumps({"busy": True, "reason": "quiet_window", "task_id": t.get("Id"),
                      "ended_at": t.get("EndTime"), "ended_s_ago": int(now - e),
                      "quiet_until_epoch": int(e + quiet)}))
    sys.exit(3)
print(json.dumps({"busy": False, "reason": "idle"}))'
}

# One regex for every journal read: bios-update, power-control and the
# EntityManager family. Classification into lists happens in python so a stub
# (which cannot run the remote grep) exercises the same code.
JOURNAL_RE='bios-update\[|power-control\[|PowerControl|entity-manager\[|EntityManager|fru-device\['
journal_split() {  # stdin: journal lines -> the three-list JSON object body (no braces)
    python3 -c '
import sys, json
bu, pc, em, inv = [], [], [], []
in_inv = False
for l in sys.stdin:
    l = l.rstrip()
    if not l or l == "JOURNAL_END":
        continue
    if l == "EM_INVENTORY":
        in_inv = True
        continue
    if in_inv:
        if l.startswith("/xyz/openbmc_project/inventory/system/"):
            inv.append(l[len("/xyz/openbmc_project/inventory/system/"):])
        continue
    if "bios-update[" in l:
        bu.append(l[-200:])
    elif "power-control[" in l or "PowerControl" in l:
        pc.append(l[-200:])
    elif "entity-manager[" in l or "EntityManager" in l or "fru-device[" in l:
        em.append(l[-200:])
print(json.dumps({"bios_update": bu[-40:], "power_control": pc[-40:],
                  "entity_manager": em[-40:], "em_inventory": inv})[1:-1])'
}
journal_fetch() {  # journal_fetch <ip> <since> -> raw lines + JOURNAL_END; rc 1 if unreachable/timed out
    # F5 (et6b4 2026-09-27): this ssh has hung >1h holding the per-BMC lock.
    # `timeout` wraps the WHOLE command substitution (a subshell), not just
    # `bmc` itself, in a fresh `bash -c` so it still finds and kills a
    # hung read within JOURNAL_FETCH_S even outside a SIGTERM to the bin
    # (which is instead handled by the PARENT's kill_tree, since fix round 2).
    # 9>&- so this whole chain never inherits the per-BMC lock fd (fix
    # round 1, same reasoning as rf()/bmc()). --kill-after=5 escalates to
    # KILL if a grandchild ignores TERM once `bash -c` itself has already
    # died -- real ssh/sshpass always die on TERM, so this is defence in
    # depth, not the primary bound.
    #
    # NO --foreground (measured 2026-09-27 fix round 1, before choosing):
    # without it, `timeout` puts its child in a NEW process group and its
    # own internal alarm signals that WHOLE group, so a true grandchild
    # (bash -c forking sshpass/ssh, not exec'ing it) is reliably killed --
    # confirmed empty-handed (no survivor) with a real fork+wait grandchild.
    # WITH --foreground, timeout's internal alarm can only reach its DIRECT
    # child (no group to signal), so a live grandchild survives -- and
    # because this call sits inside `out=$(...)`, that surviving grandchild
    # keeps the command substitution's own stdout PIPE open (fork copies
    # the pipe's write end too), so `out=$(...)` never even returns: F5's
    # own bound breaks (reproduced: a bin.sh built exactly like this one
    # hung past 15s with --foreground once bmc() truly forks instead of
    # exec'ing). --foreground only helps an OUTER group-wide kill (e.g. a
    # WRAPPING `timeout` without --foreground, or systemd's default
    # KillMode) reach this ssh directly; that scenario is NOT in this
    # task's required tests (which send SIGTERM to the bin's own PID, or
    # SIGKILL -- both verified working below), and reproducing it safely
    # needs the whole dispatch in its OWN process group (setsid), a larger
    # change than this task's scope. Documented as a residual risk in the
    # fix report, not silently dropped: an outer GROUP-wide kill can still
    # leave a harmless (fd 9 is always closed here) orphan for up to
    # JOURNAL_FETCH_S+5s, same shape as review issue #3, until a future
    # task isolates the dispatch into its own process group.
    # 9>&- is placed on the enclosing `{ ...; }` GROUP, not just the
    # `timeout` command word: bash runs a command substitution's content in
    # its OWN subshell first, and that subshell does not always exec
    # straight into a lone command's own redirections -- it can fork ONE
    # MORE time to apply them, leaving the subshell itself holding an
    # inherited, un-redirected copy of fd 9 for as long as the read hangs
    # (measured 2026-09-27: the subshell showed up as a real, if narrow,
    # second holder of the lock fd with `9>&-` on `timeout` alone -- moving
    # the redirection to the group closes fd 9 in the subshell itself,
    # before it runs anything).
    local out
    out=$( { timeout --kill-after=5 "$JOURNAL_FETCH_S" bash -c 'bmc "$@"' _ "$1" "journalctl --no-pager -o short-iso --since @$2 2>/dev/null | grep -E '$JOURNAL_RE' | grep -v 'Processing blocks'; echo EM_INVENTORY; busctl tree --list xyz.openbmc_project.EntityManager 2>/dev/null | grep /inventory/system/; echo JOURNAL_END"; } 9>&- 2>/dev/null ) || true
    printf '%s\n' "$out"
    printf '%s\n' "$out" | grep -q '^JOURNAL_END$'
}
cmd_journal() {
    local ip="$1" since="$2" raw
    if ! raw=$(journal_fetch "$ip" "$since"); then
        printf '{"error":"ssh_unreachable"}\n'; return 1
    fi
    printf '{"phase":"journal",%s}\n' "$(printf '%s\n' "$raw" | journal_split)"
}

# A local lock as well, so two callers on THIS host never race the Redfish check.
take_lock() {
    local ip="$1" dir="$LOCK_DIR"
    exec 9>"$dir/fw-update-${ip}.lock" || return 1
    flock -n 9
}

# The lock lives in LOCK_DIR (/run/flax), shared by the agents' containers
# (root) and operators on the bang host. An operator without write access
# re-runs this bin under passwordless sudo. There is deliberately NO fallback
# directory: a lock taken in a different directory is no lock at all.
# (FLAX_SUDO is the test hook.)
need_lock_dir() {
    [ -w "$LOCK_DIR" ] && return 0
    if [ "$(id -u)" != 0 ] && "${FLAX_SUDO:-sudo}" -n true 2>/dev/null; then
        exec "${FLAX_SUDO:-sudo}" -n "$0" "$@"
    fi
    echo "$(basename "$0"): cannot write the lock directory $LOCK_DIR; run as root or with passwordless sudo" >&2
    exit 2
}

# ── subcommands ───────────────────────────────────────────────────────────────

cmd_version() {
    rf GET "$1" /redfish/v1/UpdateService/FirmwareInventory/bios_active | body_of \
      | python3 -c 'import sys, json
try: print(json.load(sys.stdin).get("Version") or "")
except Exception: print("")'
}

cmd_busy() { busy_check "$1"; }

boot_id() { bmc "$1" 'cat /proc/sys/kernel/random/boot_id' 2>/dev/null | tr -d '\r\n '; }

cmd_flash() {
    local ip="${1:?bmc ip required}" url="${2:?artifact url required}"; shift 2 || true
    local port=""
    while [ $# -gt 0 ]; do case "$1" in --port) case "${2:-}" in --*|"") port="";; *) port="$2"; shift;; esac; shift;; *) shift;; esac; done
    # Task 3 fix M2: a value that is not a port (e.g. "../x") is dropped --
    # never a claim/marker file name, never a flax-forget-port argument.
    port_ok "$port" || port=""

    # NOTE (2026-09-27 fix round 2): the per-BMC local lock (fd 9) is taken
    # by the PARENT process, before this CHILD was ever forked -- see the
    # bottom of this file. This function never calls take_lock() itself
    # and never touches fd 9; by the time it runs, the lock has already
    # been held for the whole life of the child. Only the BMC's own
    # Redfish busy_check remains to be checked here.
    local b
    b=$(busy_check "$ip"); local brc=$?
    printf '%s\n' "$b" | sed 's/^{/{"phase":"interlock",/'
    [ $brc -eq 0 ] || return 3

    # $ART is created HERE, after the interlock passes (fix round 2, N3):
    # earlier rounds created it unconditionally for every `flash` call, so
    # an interlock-busy (rc 3) or bad-usage (rc 2) exit leaked a tmp file
    # every time. ART is a GLOBAL (no `local`) so the child-mode signal
    # trap at the bottom of this file -- installed before `main` is called,
    # so it is active for this whole function -- can also remove it if a
    # signal reaches this process directly (as part of the PARENT's
    # kill_tree walk). A SIGKILL of this child can still leak it in /tmp;
    # nothing catches SIGKILL, and that residual is accepted (noted in the
    # fix report) rather than solved by a bigger redesign.
    ART="$(mktemp "${TMPDIR:-/tmp}/bios-fw-XXXXXX.tar")"
    local art="$ART"
    trap 'trap - RETURN; rm -f "$art"' RETURN
    if ! fetch "$url" "$art" || [ ! -s "$art" ]; then
        emit fetching 0 "" FetchFailed; echo "fetch failed: $url" >&2; return 1
    fi

    local boot0 t0; boot0="$(boot_id "$ip")"; t0="$(now_s)"

    emit flashing 0 "" Uploading
    local resp code task
    resp=$(RF_MAX_TIME=600 rf POST "$ip" /redfish/v1/UpdateService/update \
        -F 'UpdateParameters={"Targets":["/redfish/v1/Managers/bmc"],"@Redfish.OperationApplyTime":"Immediate"};type=application/json' \
        -F "UpdateFile=@${art};filename=image.tar;type=application/octet-stream")
    code="$(printf '%s' "$resp" | code_of)"
    if [ "$code" = "423" ]; then
        emit interlock 0 "" Busy http_423
        echo "BMC reports an update in progress (423); not overriding it" >&2; return 3
    fi
    if [ "$code" != "200" ] && [ "$code" != "202" ]; then
        emit flashing 0 "" Rejected "http_$code"; printf '%s\n' "$resp" | body_of >&2; return 1
    fi
    task=$(printf '%s' "$resp" | body_of | python3 -c 'import sys, json, re
d = sys.stdin.read()
try: o = json.loads(d).get("@odata.id", "")
except Exception: o = ""
m = re.search(r"/TaskService/Tasks/([^\"/\s]+)", o or d)
print(m.group(1) if m else "")')
    [ -n "$task" ] || { emit flashing 0 "" Rejected no_task_id; return 1; }

    local deadline=$(( $(now_s) + TASK_WAIT_S )) fails=0 st pct t
    while :; do
        t=$(rf GET "$ip" "/redfish/v1/TaskService/Tasks/$task")
        if [ "$(printf '%s' "$t" | code_of)" != "200" ]; then
            fails=$((fails + 1))
            if [ $fails -ge "$POLL_FAIL_MAX" ]; then emit flashing 0 "$task" Unreachable; return 1; fi
        else
            fails=0
            read -r st pct < <(printf '%s' "$t" | body_of | python3 -c 'import sys, json
try: d = json.load(sys.stdin); print(d.get("TaskState", ""), d.get("PercentComplete", 0) or 0)
except Exception: print("", 0)')
            emit flashing "${pct:-0}" "$task" "${st:-}"
            case "$st" in
                # Task 3: bios-update may power/cycle the host and, with an
                # ME change, the BMC -- mark the reboot at Completed.
                Completed) mark_reboot "$port"; break ;;
                Exception|Killed|Cancelled) echo "task $task ended: $st" >&2; return 1 ;;
            esac
        fi
        [ "$(now_s)" -lt "$deadline" ] || { emit flashing "${pct:-0}" "$task" Timeout; return 1; }
        nap "$POLL_S"
    done

    # The journal, NOW, before it rolls: bios-update's lines plus flashcp's
    # "diff blocks" (logged under bios-update[<flashcp pid>]), plus the
    # power-control / EntityManager lists R4 needs for diagnosis.
    #
    # 9>&- on THIS substitution too (2026-09-27 fix round 1): this is the
    # ONE call in cmd_flash whose subshell can live as long as the hang
    # itself (every other substitution here is a quick curl/python
    # round trip) -- without it, THIS subshell (not journal_fetch's own
    # inner one, which already closes it) is left holding an inherited,
    # un-redirected copy of fd 9 for the whole hang (measured).
    local raw jl lists
    raw=$( { journal_fetch "$ip" "$t0"; } 9>&- ) || raw=""
    jl=$(printf '%s\n' "$raw" | grep -F 'bios-update[')
    lists=$(printf '%s\n' "$raw" | journal_split)

    local verdict
    verdict=$(printf '%s' "$jl" | PORT="$port" TASK="$task" LISTS="$lists" python3 -c '
import sys, json, os, re
lines = [l.rstrip() for l in sys.stdin if l.strip()]
txt = "\n".join(lines)
def has(s): return s in txt
me = None
if has("ME region is unchanged"): me = False
if has("ME region DIFFERS") or has("assuming the ME region changes") or has("assuming it changes"): me = True
m = re.search(r"diff blocks: (\d+)", txt); diff = int(m.group(1)) if m else None
m = re.search(r"host state after power-on: (\S+)", txt); hs = m.group(1) if m else None
err = [l for l in lines if "bios-update: error" in l]
if not lines:                              ending = "unknown"
elif err and not has("flash complete"):    ending = "failed"
elif me and has("scheduling node power cycle"): ending = "me_changed_cycle_scheduled"
elif me:                                   ending = "me_changed_no_cycle"
elif hs and "Off" not in hs and hs != "unknown": ending = "booted"
elif has("host did not come up"):          ending = "poweron_failed"
else:                                      ending = "unknown"
d = {"phase": "verdict", "port": os.environ.get("PORT", ""),
     "task_id": os.environ.get("TASK", ""), "ending": ending,
     "me_changed": me, "diff_blocks": diff, "host_state_after_poweron": hs,
     "errors": err[-3:], "lines": [l[-200:] for l in lines[-40:]]}
d.update(json.loads("{" + os.environ.get("LISTS", "") + "}"))
d.pop("bios_update", None)
print(json.dumps(d))')

    local ending
    ending=$(printf '%s' "$verdict" | python3 -c 'import sys, json; print(json.load(sys.stdin)["ending"])')
    if [ "$ending" = "me_changed_cycle_scheduled" ]; then
        # Did the scheduled cut really happen? A dropped BMC (no answer) or a new
        # boot_id says yes; the same boot_id after CUT_WAIT_S says it did not.
        local cut="unknown" cd=$(( $(now_s) + CUT_WAIT_S )) b1
        while [ "$(now_s)" -lt "$cd" ]; do
            nap "$CUT_POLL_S"
            b1="$(boot_id "$ip")"
            if [ -z "$b1" ]; then cut="bmc_dropped"; break; fi
            if [ -n "$boot0" ] && [ "$b1" != "$boot0" ]; then cut="bmc_rebooted"; break; fi
        done
        if [ "$cut" = "unknown" ] && [ -n "$boot0" ] && [ "$(boot_id "$ip")" = "$boot0" ]; then
            cut="cut_missing"
        fi
        verdict=$(printf '%s' "$verdict" | CUT="$cut" python3 -c 'import sys, json, os
d = json.load(sys.stdin); d["cut"] = os.environ["CUT"]; print(json.dumps(d))')
    fi
    printf '%s\n' "$verdict"
    return 0
}

main() {
    case "${1:-}" in
        version) [ $# -eq 2 ] || { echo "usage: bios-fw-update version <bmc-ip>" >&2; exit 2; }; cmd_version "$2" ;;
        busy)    [ $# -eq 2 ] || { echo "usage: bios-fw-update busy <bmc-ip>" >&2; exit 2; }; cmd_busy "$2" ;;
        flash)   [ $# -ge 3 ] || { echo "usage: bios-fw-update flash <bmc-ip> <artifact-url> [--port P]" >&2; exit 2; }; shift; cmd_flash "$@" ;;
        journal) [ $# -eq 3 ] || { echo "usage: bios-fw-update journal <bmc-ip> <since-epoch>" >&2; exit 2; }; cmd_journal "$2" "$3" ;;
        *) echo "usage: bios-fw-update {version|busy|flash|journal} ..." >&2; exit 2 ;;
    esac
}

if [ -n "${FLAX_BIN_CHILD:-}" ]; then
    # ── CHILD (2026-09-27 fix round 2; marker hardened round 3, I1/M3) ──
    # $FLAX_BIN_CHILD carries the PARENT's own pid (not a literal "1"), so
    # this checks $PPID against it before doing anything else. `setpriv`
    # only arms --pdeathsig AFTER it execs (a prctl() call in the child's
    # own new image) -- if the PARENT is killed in the narrow window
    # between the fork and that exec, the kernel never delivers KILL to
    # this process at all, and it would otherwise run `main` all the way
    # to the 12V cut with NO lock held and NO parent left (measured: 1/550
    # natural runs, reproducible every time with a slowed `setpriv`). Bash
    # sets $PPID at process startup, which for a re-exec'd script means
    # AFTER the prctl -- so if this process was already reparented (to
    # init or a subreaper) before its own startup, $PPID no longer equals
    # the pid the PARENT put in the marker, and it exits immediately
    # instead of running unlocked. `unset` afterward so no nested call
    # this bin might someday make (none does today) inherits a stale
    # marker and silently skips its own lock (M3).
    [ "$PPID" = "$FLAX_BIN_CHILD" ] || exit 70
    unset FLAX_BIN_CHILD
    # The PARENT already holds the per-BMC lock and owns all TERM/INT/HUP
    # handling via kill_tree; this process must not compete with it (no
    # `trap on_signal ...` here). It DOES need its own minimal handler so a
    # signal reaching it directly (as part of the PARENT's kill_tree walk)
    # still removes $ART before it dies -- kill_tree only sends the
    # signal, it has no idea $ART exists.
    trap 'rm -f "${ART:-}" 2>/dev/null; exit 143' TERM INT HUP
    main "$@"
    exit $?
fi

# ── PARENT (the pid callers see) ────────────────────────────────────────
[ "${1:-}" = flash ] && need_lock_dir "$@"
if [ "${1:-}" = flash ]; then
    ip="${2:-}"
    if ! take_lock "$ip"; then
        emit interlock 0 "" Busy local_lock
        echo "another bios/bmc fw update for $ip is running on this host" >&2
        exit 3
    fi
    # Task 3: the manual claim, taken only once the lock is ours. Until
    # on_signal is armed below, a TERM/INT/HUP still removes it.
    trap 'claim_release; exit 143' TERM INT HUP
    claim_take "$(arg_port "$@")"
fi
# Re-exec the whole body as a CHILD that never sees fd 9 (2026-09-27 fix
# round 2, N2): a command-substitution subshell inherits an open fd across
# a fork, so nothing short of a SEPARATE process with fd 9 closed at its
# own exec keeps the lock's fate tied to THIS process alone.
# `--pdeathsig KILL` (util-linux setpriv) makes the kernel SIGKILL the
# child the instant this PARENT dies for ANY reason -- including a SIGKILL
# to this process, which no trap can catch -- so a killed bin can never go
# on to finish a push after its caller has given up on it. The marker is
# THIS process's own pid, checked by the child above (I1) -- not a literal
# "1" -- and `readlink -f` resolves `$0` to an absolute path (fix round 3,
# M2) so setpriv's execvp() never falls through to a PATH search, which
# could otherwise run some OTHER same-named binary as the child while this
# process still holds the lock.
FLAX_BIN_CHILD=$$ setpriv --pdeathsig KILL "$(readlink -f -- "$0")" "$@" 9>&- &
CHILD=$!
trap on_signal TERM INT HUP
hb_start   # Task 3: claim heartbeat (no-op without a claim)
# Only re-wait while the child is actually still alive (2026-09-27 fix
# round 2, N1): bash keeps the SAVED exit status of an already-reaped pid,
# so `wait "$CHILD"` after the child is gone returns that same status
# forever -- a naive `while [ "$rc" -gt 128 ]` loop (round 1) spun at 100%
# CPU whenever the child ended above 128 for a reason unrelated to a
# signal THIS process received (the child killed directly, or SIGPIPE from
# a closed stdout). `kill -0` distinguishes "wait was itself interrupted,
# child still alive, wait again" from "the child is actually dead", so
# this exits promptly either way.
# Task 3: the heartbeat ticker's USR1 also interrupts `wait` -- same
# "child still alive -> wait again" path, touching the claim on the way.
# After the loop, one more `wait` reads the child's REAL status (a USR1 that
# lands just as the child exits would otherwise leave rc=138).
while :; do
    wait "$CHILD"; rc=$?
    kill -0 "$CHILD" 2>/dev/null || break
    claim_heartbeat
done
hb_stop
wait "$CHILD"; rc=$?
claim_release
exit "$rc"
