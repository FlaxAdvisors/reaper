#!/usr/bin/env python3
# scripts/gen-nic-fw-manifest
"""Generate /etc/flax/nic-firmware-versions.json from the curated PSID->image
intent, enriching each entry with the authoritative target_version +
target_psid queried from the bin via `mstflint -i` on a booted node. Usage:
  gen-nic-fw-manifest <ssh-host-ip>   # SSHes the node (host creds) to query bins

INTENT below MIRRORS the FWMAP in
roles/apply_pxe_payloads/files/post/update_mellanox.sh -- that table is what
actually burns the card, this one is what nicd compares against, and the two
drifting apart makes nicd report a correctly-flashed card as out of date.
Change FWMAP first, then re-derive this dict and
roles/apply_flax_post/files/nic-firmware-versions.json from it.
"""
import json
import sys

