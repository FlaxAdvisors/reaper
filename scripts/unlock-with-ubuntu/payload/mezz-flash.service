[Unit]
Description=Mellanox mezzanine FW-lock unlock pass (flash, then blink IDENT)
# The station's whole cycle is: blade inserted -> boots -> this runs -> IDENT
# blinks -> operator pulls the blade live. There is no clean shutdown, ever.
After=multi-user.target
Wants=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/flax/mezzflash
# In-band IPMI only: with a jumpered mezzanine card the BMC's NC-SI path is
# dark, so there is no LAN to reach it over. Wait for the KCS device rather
# than racing ipmi_si's probe.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/ipmi0 ] && exit 0; sleep 1; done; echo "no /dev/ipmi0"; exit 0'
ExecStart=/opt/flax/mezzflash/unlock_mellanox.sh
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
