#!/usr/bin/env python3.12
"""Rule zero for reaper: no cleartext secret, and no binary, ever lands in git.

  check-secrets pre-commit            the staged changes (git hook)
  check-secrets pre-push              every commit about to be pushed (git hook; reads
                                      git's "<local ref> <sha> <remote ref> <sha>" stdin)
  check-secrets range <a>..<b>        the commits in a range
  check-secrets tree                  every tracked file as it is now (audit)

Blocks:
  * a site credential file or vault file that is not ansible-vault encrypted
    (files/configs/<site>/services/credentials*.json, any vault*.yml / *.vault)
  * a .vault_pass* file
  * a binary file (git carries recipes + text; blobs live on a bang)
  * an added line holding a private key, a full crypt hash ($1$/$5$/$6$/$y$/$2b$),
    or a literal password after sshpass -p / ipmitool -P
Fetched device config (files/configs/<site>/<host>/config/) is exempt from the hash
rule: device hashes stay literal by operator decision 2026-08-26 (redact_secrets
replaces the cleartext secrets there; pushing a wrong hash locks a switch out).
A deliberate fake in a test can carry the marker `secrets-ok` on the same line.
Operator-ruled vendor defaults are listed in RULED (path, rule, exact form); keep it in
step with the exception list in reaper-devel/CLAUDE.md.
Bypassing with --no-verify is for a false positive you have looked at, never for a
real value: a pushed secret needs rotation, history rewrites do not un-publish it.
Stdlib only. Runs on python3.12, the same interpreter on every machine (bangs:
/usr/bin/python3.12 from apply_reaper_toolchain; dev machines: ./setup).
"""
import re
import subprocess
import sys

ZERO = "0" * 40
VAULT_HEAD = b"$ANSIBLE_VAULT"
VAULT_PATH = re.compile(r"(^|/)files/configs/[^/]+/services/credentials[^/]*\.json$"
                        r"|(^|/)[^/]*vault[^/]*\.ya?ml$|\.vault$")
PASS_FILE = re.compile(r"(^|/)\.vault_pass")
B64 = r"[./0-9A-Za-z]"
LINE_RULES = [
    ("private key", re.compile(r"-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----")),
    ("crypt hash", re.compile(r"\$(?:1\$%s{1,8}\$%s{22}|5\$(?:rounds=\d+\$)?%s{1,16}\$%s{43}"
                              r"|6\$(?:rounds=\d+\$)?%s{1,16}\$%s{86}|y\$%s+\$%s+\$%s{43}"
                              r"|2[aby]\$\d\d\$%s{53})" % ((B64,) * 10))),
    ("literal password", re.compile(r"\bsshpass\s+-p\s*['\"]?(?![$'\"{<])[^\s'\"]{3,}"
                                    r"|\bipmitool\b[^\n]*?\s-P\s*['\"]?(?![$'\"{<\-])[^\s'\"]{3,}")),
]
ALLOW = "secrets-ok"
DEVICE_CONFIG = re.compile(r"^files/configs/[^/]+/[^/]+/config/")
# Published vendor factory defaults the operator ruled may stay literal. Each entry is
# scoped to one file, one rule and the exact form, so a new literal there still blocks.
RULED = [
    # legacy AMI OEM BMC factory login, probed before branching (operator ruling 2026-11-11)
    ("scripts/bmc-enable-inband-admin.sh.j2", "literal password",
     re.compile(r"-U admin -P admin(\s|$)")),
]


def git(*args, inp=None):
    return subprocess.run(("git",) + args, input=inp, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, check=True).stdout


def is_binary(blob):
    if b"\x00" in blob:
        return True
    try:
        blob.decode("utf-8")
    except UnicodeDecodeError:
        return True
    return False


def check_file(path, blob):
    """Problems with a file's whole content (added or modified)."""
    out = []
    if PASS_FILE.search(path):
        out.append("%s: a vault password file" % path)
    elif VAULT_PATH.search(path) and not blob.lstrip().startswith(VAULT_HEAD):
        out.append("%s: must be ansible-vault encrypted (does not start with $ANSIBLE_VAULT)"
                   % path)
    elif is_binary(blob):
        out.append("%s: binary file (keep blobs on a bang; commit the recipe + sha256)" % path)
    return out


def check_lines(path, lines):
    out = []
    for n, line in lines:
        if ALLOW in line:
            continue
        for what, rx in LINE_RULES:
            if what == "crypt hash" and DEVICE_CONFIG.match(path):
                continue
            if any(path == rp and what == rw and rx.search(line) for rp, rw, rx in RULED):
                continue
            if rx.search(line):
                out.append("%s:%s: %s" % (path, n if n else "+", what))
    return out


def added_lines(diff):
    """{path: [(new line number, text)]} for the + lines of a unified diff."""
    res, path, n = {}, None, 0
    for raw in diff.decode("utf-8", "replace").splitlines():
        if raw.startswith("+++ "):
            path = raw[6:] if raw.startswith("+++ b/") else None
        elif raw.startswith("@@"):
            m = re.search(r"\+(\d+)", raw)
            n = int(m.group(1)) if m else 0
        elif path and raw.startswith("+"):
            res.setdefault(path, []).append((n, raw[1:]))
            n += 1
        elif path and not raw.startswith("-"):
            n += 1
    return res


def changed(base_args):
    """Paths added/copied/modified/renamed in a diff (deletions need no check)."""
    out = git("diff", "--name-only", "-z", "--no-renames", "--diff-filter=ACMRT", *base_args)
    return [p for p in out.decode("utf-8", "replace").split("\0") if p]


def check_staged():
    problems = []
    for path in changed(["--cached"]):
        problems += check_file(path, git("show", ":" + path))
    for path, lines in added_lines(git("diff", "--cached", "-U0", "--no-color")).items():
        problems += check_lines(path, lines)
    return problems


def check_commit(sha):
    parents = git("rev-list", "--parents", "-n1", sha).decode().split()[1:]
    base = parents[0] if parents else git("hash-object", "-t", "tree", "/dev/null").decode().strip()
    problems = []
    for path in changed([base, sha]):
        problems += check_file(path, git("show", "%s:%s" % (sha, path)))
    for path, lines in added_lines(git("diff", "-U0", "--no-color", base, sha)).items():
        problems += check_lines(path, lines)
    return ["%s %s" % (sha[:9], p) for p in problems]


def check_revs(revs):
    problems = []
    for sha in revs:
        problems += check_commit(sha)
    return problems


def pushed_revs(stdin):
    revs = []
    for line in stdin.splitlines():
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:
            continue                                   # a branch delete pushes nothing
        local, remote = parts[1], parts[3]
        spec = [local, "--not", "--remotes"] if remote == ZERO else ["%s..%s" % (remote, local)]
        revs += [r for r in git("rev-list", "--reverse", *spec).decode().split() if r not in revs]
    return revs


def check_tree():
    problems = []
    for path in git("ls-files", "-z").decode("utf-8", "replace").split("\0"):
        if not path:
            continue
        try:
            blob = open(path, "rb").read()
        except OSError:
            continue
        found = check_file(path, blob)
        if not found and not is_binary(blob):
            found = check_lines(path, enumerate(blob.decode("utf-8").splitlines(), 1))
        problems += found
    return problems


def main(argv):
    mode = argv[1] if len(argv) > 1 else ""
    if mode == "pre-commit":
        problems = check_staged()
    elif mode == "pre-push":
        problems = check_revs(pushed_revs(sys.stdin.read()))
    elif mode == "range" and len(argv) == 3:
        problems = check_revs(git("rev-list", "--reverse", argv[2]).decode().split())
    elif mode == "tree":
        problems = check_tree()
    else:
        sys.stderr.write(__doc__)
        return 2
    if problems:
        sys.stderr.write("check-secrets (%s): BLOCKED, rule zero / no binaries in git:\n  %s\n"
                         % (mode, "\n  ".join(problems)))
        sys.stderr.write("Fix it (vault-encrypt, move the blob to a bang, use a vault var). "
                         "A deliberate test fake may carry `secrets-ok` on its line.\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
