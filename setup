#!/usr/bin/env bash
# setup — bootstrap a new operator's environment for reaper.
# Idempotent: safe to re-run after pulling updates or adding a new site.
set -euo pipefail

REAPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m  ok\033[0m %s\n' "$*"; }
added() { printf '\033[1;33m  +\033[0m %s\n' "$*"; }

# ---------------------------------------------------------------------------
# 1. The pinned toolchain venv (python 3.12 + ansible-core + collections)
# ---------------------------------------------------------------------------
# Same builder as the bangs' apply_reaper_toolchain role; nothing goes into the
# system python or ~/.ansible. A bang with the shared venv needs no venv of its own.
SHARED_VENV=/opt/flax/venv/reaper-ansible
if [[ -z "${REAPER_VENV:-}" && ! -x "$HOME/.venv-reaper-ansible/bin/python" && -x "$SHARED_VENV/bin/python" ]]; then
    ok "using the bang's shared toolchain: $SHARED_VENV"
    TOOLPY="$SHARED_VENV/bin/python"
else
    info "Building the pinned toolchain venv"
    "$REAPER_DIR/scripts/toolchain-venv.sh" "${REAPER_VENV:-$HOME/.venv-reaper-ansible}"
    TOOLPY="${REAPER_VENV:-$HOME/.venv-reaper-ansible}/bin/python"
fi

# python3.12 = the flax service image's interpreter (3.12.13): the test venv and the
# rule-zero git hooks run on it. A bang gets /usr/bin/python3.12 from apply_reaper_toolchain;
# elsewhere uv provides it (~/.local/bin/python3.12).
if command -v python3.12 >/dev/null 2>&1; then
    ok "python3.12: $(python3.12 -V 2>&1)"
elif command -v uv >/dev/null 2>&1; then
    info "Installing python 3.12.13 (uv)"
    uv python install 3.12.13
else
    printf '\033[1;31m  !\033[0m no python3.12 and no uv: install uv (https://docs.astral.sh/uv/) and re-run ./setup\n'
fi

# ---------------------------------------------------------------------------
# 2. reaper setup: git hooks, ~/.ssh/config.d/reaper-jumphosts, and the shell environment
#    (~/.ssh/config Includes, reaper on PATH, ~/.bashrc, ~/jumphosts.txt: scripts/shell-env.sh).
#    Re-run it alone in any clone to (re)do those.
# ---------------------------------------------------------------------------
info "Running 'reaper setup'"
"$REAPER_DIR/reaper" setup

# ---------------------------------------------------------------------------
printf '\n\033[1;32mSetup complete.\033[0m\n'
printf 'Run \033[1msource ~/.bashrc\033[0m or open a new shell to pick up tab completion, pdsh env vars and reaper on PATH.\n'
printf '\nNote: vault password files (~/.vault_pass_<site>) are not created by this script.\n'
printf 'Obtain them from a project admin before running reaper commands.\n'
